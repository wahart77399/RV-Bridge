#include "SpanView.h"
#include "HomeSpan.h"
#include "PacketQueue.h"
#include "DGN.h"
#include "CoverDeviceDefinitions.h"

class CoverDevice;;




// DC SwitchView provides the view of the HomeKit - it is both a View from MVC is built as a facade to the SpanService
// see HomeSpan.h for more info
class CoverView : public SpanView  {
    private:
        
        const  char*	spanDeviceName;
        static bool 	bridgeCreated;
        static void 	createBridge(void); 

        friend class CoverDevice;

                        // cohesision helpers for working with model
        CoverKind kind(void) const;

        struct CoverController: Service::WindowCovering {

                CoverDevice*        model;
                CoverView*          view;
                SpanCharacteristic* currentState;
                SpanCharacteristic* targetState;
                SpanCharacteristic* obstructionDetected;

                // desired commands
                boolean            extendCommand_ = false;
                boolean            retractCommand_ = false;
                boolean            stopCommand_ = false;

                // timing variables
                float               timeToFullyExtend_;
                float               timeToFullyRetract_;
                float               targetExtendedPosition_;           // percentage of awning extended 0.0 to 100.0
                float               currentExtendedPosition_;          // percentage of awning extended 0.0 to 100.0
                elapsedMillis       startTime_;                        // time when the awning started moving 
                uint16_t            travelTime_;                       // time it takes to open or close the awning to the target position
                boolean             coverMoving_;                     // is the awning currently moving

                // setters/getters
                boolean extendCommand(void) const { return extendCommand_; }
                void extendCommand(const boolean b) { extendCommand_ = b; }
                boolean retractCommand(void) const { return retractCommand_; }
                void retractCommand(const boolean b) { retractCommand_ = b; }
                boolean stopCommand(void) const { return stopCommand_; }
                void stopCommand(const boolean b) { stopCommand_ = b; } 

                // timing setters/getters
                float timeToFullyExtend(void) const { return timeToFullyExtend_; }
                void timeToFullyExtend(const float tm) { timeToFullyExtend_ = tm; }
                float timeToFullyRetract(void) const { return timeToFullyRetract_; } 
                void timeToFullyRetract(const float tm) { timeToFullyRetract_ = tm; }
                float targetExtendedPosition(void) const { return targetExtendedPosition_; }
                void targetExtendedPosition(const float tg) { targetExtendedPosition_ = tg; }
                float currentExtendedPosition(void) const { return currentExtendedPosition_; }
                void currentExtendedPosition(const float tg) { currentExtendedPosition_ = tg; }
                elapsedMillis startTime(void) const { return startTime_; }
                void startTime(const elapsedMillis tm) { startTime_ = tm; }
                uint16_t travelTime(void) const { return travelTime_; }
                void travelTime(const uint16_t tm) { travelTime_ = tm; }
                boolean coverMoving(void) const { return coverMoving_; }
                void coverMoving(const boolean b) { coverMoving_ = b; }

                


                
                // remember fully retracted in HOMEKIT window coverings is 100
                CoverController(CoverView* vw, GenericDevice* mdl, const char* spanDeviceName, float extendTime, float retractTime) : Service::WindowCovering(), 
                                    timeToFullyExtend_(extendTime), timeToFullyRetract_(retractTime), targetExtendedPosition_(0.0F), currentExtendedPosition_(0.0F), startTime_(0), travelTime_(0), coverMoving_(false) {
                    if ((vw != nullptr) && (vw->kind() == CoverKind::Awning)) {
                        currentState = new Characteristic::CurrentPosition(AWNING_FULLY_EXTENDED_PCT); // default to fully extended
                        currentState->setRange(AWNING_FULLY_EXTENDED_PCT, AWNING_FULLY_RETRACTED_PCT, AWNING_STEP_PCT);               
                        targetState = new Characteristic::TargetPosition(AWNING_FULLY_RETRACTED_PCT);   // default to fully open
                        targetState->setRange(AWNING_FULLY_EXTENDED_PCT, AWNING_FULLY_RETRACTED_PCT, AWNING_STEP_PCT);
                        
                    } else if (vw != nullptr) {
                        currentState = new Characteristic::CurrentPosition(SHADES_FULLY_OPEN_PCT); // default to fully open
                        currentState->setRange(SHADES_FULLY_OPEN_PCT, SHADES_FULLY_CLOSED_PCT, SHADES_STEP_PCT);
                        targetState = new Characteristic::TargetPosition(SHADES_FULLY_OPEN_PCT);   // default to fully open
                        targetState->setRange(SHADES_FULLY_OPEN_PCT, SHADES_FULLY_CLOSED_PCT, SHADES_STEP_PCT);
                    }
                    currentState->setDescription("Cover Current Position");
                    targetState->setDescription("Cover Target Position");
                    obstructionDetected = new Characteristic::ObstructionDetected();
                    this->model = reinterpret_cast<CoverDevice* >(mdl);
                    view = vw;
                }

                // prep commands 
                // awning
                void readyToExtend(void) { extendCommand(true); retractCommand(false); stopCommand(false); }
                void readyToClose(void) { readyToExtend(); }
                boolean isReadyToExtend(void) { return extendCommand(); }
                boolean isReadyToClose(void) { return isReadyToExtend(); }
                void readyToRetract(void) { extendCommand(false); retractCommand(true); stopCommand(false); }
                void readyToOpen(void) { readyToRetract(); }
                boolean isReadyToRetract(void) { return retractCommand(); }
                boolean isReadyToOpen(void) { return isReadyToRetract(); }
                void readyToStop(void)   { extendCommand(false); retractCommand(false); stopCommand(true); }
                boolean isReadyToStop(void) { 
                    unsigned long stime = startTime();
                    if ((isCoverInMotion() && (stime >= travelTime())) || (stopCommand() == true)) {
                        // RV_PRINTF("CoverView::CoverController::isReadyToStop stime=%d, travelTime =%d, stopCommand =%d \n", stime, travelTime, stopCommand);
                        clearCommands();
                        stopCommand(true); // we are done moving
                        stopMoving();
                    }
                    return stopCommand(); 
                }
                void clearCommands(void) { extendCommand(false); retractCommand(false); stopCommand(false); }

                void startMoving(void) {
                    startTime(static_cast<elapsedMillis>(0));
                    coverMoving(true);
                }
                void stopMoving(void) {
                    startTime(static_cast<elapsedMillis>(0));
                    travelTime(0U);
                    coverMoving(false);
                    clearCommands();
                }


                void extendCover(float amt);
                void retractCover(float amt);
                void stopCover(void);

                // void targetUpdate(void);
                boolean update(void); 
                void loop(void);

                // clarification of status
                boolean isCoverExtended(void); 
                boolean isCoverRetracted(void);
                boolean isCoverInMotion(void)          { return coverMoving(); }
                boolean isCoverFullyExtended(void);
                boolean isCoverFullyRetracted(void);
                boolean isOut(void) {
                    boolean out = false; 
                    uint8_t st = currentState->getVal<uint8_t>();
                    if ((view != nullptr) && (view->kind() == CoverKind::Awning))
                        out = (st == AWNING_FULLY_EXTENDED_PCT); 
                    else
                        out = (st == SHADES_FULLY_CLOSED_PCT);
                    return out;
                }
                void setCoverObstruction(boolean val)  { obstructionDetected->setVal(val); }

        }; 
        CoverController*           controller;

        struct CoverExtendRetractController : public Service::Switch {
                CoverDevice*        model;
                CoverView*          view;
                CoverController*    coverController;
                SpanCharacteristic* out; // send it fully out

                CoverExtendRetractController(CoverView* vw, GenericDevice* mdl, CoverController* awnCtrl) : Service::Switch() {
                    model = reinterpret_cast<CoverDevice*>(mdl);
                    view =  vw;
                    coverController = awnCtrl;
                    out = new Characteristic::On();
                    out->setDescription("Send Cover Out(on) or In(off)");
                    out->setVal(false); // default to awning not out / shades not down
                }

                void extending(boolean val) { out->setVal(val); PacketQueue::clearLastPacketReceiveTime();}
                void closing(boolean val) { out->setVal(val); PacketQueue::clearLastPacketReceiveTime();}
                boolean update(void); 
                void loop(void);
        };
        CoverExtendRetractController* extendRetractController;

        void setController(CoverController* ctrl) {controller = ctrl; }
        void setExtendRetractController(CoverExtendRetractController* ctrl) {extendRetractController = ctrl; }

    protected:
        // @brief need to review this... doesn't seem right SpanService(type, name)
        CoverView(GenericDevice* model, const char* spanDevName);
    public:

        // static void cmdCallback(RVC_DGN dgn, const char* buff);
        
        /// @brief destructor
        virtual ~CoverView(void) { 
        }

        // update HomeSpan view per changes in model
        virtual bool updateView(void);

        static void createCoverView(GenericDevice* model, const char* spanDevName, 
                                     float extTime = FRONT_AWNING_EXTEND_CYCLE_TIME_SEC, 
                                     float retTime = FRONT_AWNING_RETRACT_CYCLE_TIME_SEC); 
        
        
};
// #endif  // ifndef AWNING_VIEW_H
#endif // ifdef HOME_KIT_2
