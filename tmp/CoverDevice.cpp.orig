#include "RVConstants.h"
#ifdef HOME_KIT_2
#include "Arduino.h"
#include "CoverDevice.h"
#include "CanFrameTypes.h"
#include "Packet.h"
#include "DGN.h"
#include "debug.h"



CAN_frame_t* CoverDevice::buildCommand(RVC_DGN dgn) {
    // RV_PRINTF("CoverDevice::buildCommand called with dgn=%#x\n", dgn);
    CAN_frame_t* frame = GenericDevice::buildCommand(dgn); // initiates the building of the frame => starting with instance and the dgn (ie the first 2 bytes)
    if (frame != nullptr) {
        // RV_PRINTF("CoverDevice::buildCommand: frame built with MsgID=%#x\n", frame->MsgID);
        const uint8_t* sendData = (uint8_t* )getCurrentData(); 
        const uint8_t* cData = (uint8_t* ) getCommandData();
        const char* buff = nullptr;
        if (kind() == CoverKind::Awning) {
            switch (dgn) {
                case AWNING_COMMAND_2:
                    RV_PRINTF("CoverDevice::buildCommand: ******** WARNING *********** AWNING_COMMAND_2 called - need to support this command\n");
                    break;
                case AWNING_COMMAND: {                // Handle second DC Dimmer command
                    // RV_PRINTF("CoverDevice::buildCommand: Handling AWINING_COMMAND\n");
                    uint8_t* d = frame->data.u8;
                    if ((d != nullptr) && (cData != nullptr)) {
                        // Handle switch ON command for second dimmer
                        for (int i = 1; i < 8; i++)
                            d[i] = cData[i];
                        // RV_PRINTF("CoverDevice::buildCommand AWNING_COMMAND received with d[0] = %8x, d[1] = %8x, d[2] = %8x, d[3] = %8x, d[4] = %8x, d[5] = %8x, d[6] = %8x, d[7] = %8x.\n", 
                        //        d[0], d[1], d[2], d[3], d[4], d[5], d[6], d[7]);       
                    } else {
                        // Handle unknown command for second dimmer
                        RV_PRINTF("Unknown command received.\n");
                    }
                    break;
                }
                case AWNING_STATUS_2:
                    RV_PRINTF("CoverDevice::buildCommand CoverDevice Status 2 received, ********* WARNING*********** need to support this status \n");
                    break;
                case AWNING_STATUS:   
                    //RV_PRINTF("CoverDevice::buildCommand: CoverDevice Status received.\n");
                    setData(dgn, (uint8_t* )sendData);
                    break;
                default:
                    // Handle other commands or unknown DGN
                    break;
            }
        } else {
            switch (dgn) {
                case WINDOW_SHADE_CONTROL_COMMAND: {                // Handle second DC Dimmer command
                    // RV_PRINTF("Shades::buildCommand: Handling LOCK_COMMAND\n");
                    uint8_t* d = frame->data.u8;
  
                    if ((d != nullptr) && (sendData != nullptr)) {
                        // Handle switch ON command for second dimmer
                        d[SHADE_INSTANCE_INDEX] = sendData[SHADE_INSTANCE_INDEX];
                        d[SHADE_GROUP_INDEX] = sendData[SHADE_GROUP_INDEX];
                        d[SHADE_MOTOR_DUTY_INDEX] = sendData[SHADE_MOTOR_DUTY_INDEX];
                        d[SHADE_COMMAND_INDEX] = sendData[SHADE_COMMAND_INDEX];
                        d[SHADE_DURATION_INDEX] = sendData[SHADE_DURATION_INDEX];
                        d[SHADE_INTERLOCK_INDEX] = sendData[SHADE_INTERLOCK_INDEX];

                        RV_PRINTF("Shades::buildCommand lock/unlock command received with %u value.\n", d[1]);       

                        // RV_PRINTF("Shades::buildCommand: d[0]=%d, d[1]=%d, d[2]=%d, d[3]=%d, d[4]=%d, d[5]=%d, d[6]=%d, d[7]=%d, val=%d, setLockedFlag=%d\n", 
                        //       d[0], d[1], d[2], d[3], d[4], d[5], d[6], d[7], val, isLocked());

                    } else {
                        // Handle unknown command for second dimmer
                        RV_PRINTF("Unknown command received.\n");
                    }
                    break;
                }
                case WINDOW_SHADE_CONTROL_STATUS:   
                    setData(dgn, (uint8_t* )sendData);
                    RV_PRINTF("Shades::buildCommand: WINDOW SHADE CONTROL Status received.\n");
               
                break;
            default:
                // Handle other commands or unknown DGN
                break;
        }
        }
        
    }
    return frame;
}



#include "PacketQueue.h"
// ------------------------------------------------------------------
// Public behaviour
// ------------------------------------------------------------------
void CoverDevice::configureTimings(uint16_t extend, uint16_t retract)
{
    extendSec(extend);
    retractSec(retract);
}

boolean CoverDevice::executeCommand(RVC_DGN dgn, const uint8_t* data, uint8_t sAddress) {
    // RV_PRINTF("CoverDevice::executeCommand called with dgn=%#x\n", dgn);
    boolean cmdExecuted = GenericDevice::executeCommand(dgn, data);
    if (!cmdExecuted) { // && (data != nullptr)) {
        // RV_PRINTF("CoverDevice::executeCommand: Command not executed, building command for dgn=%#x\n", dgn);
        CAN_frame_t* frame = nullptr;
        uint8_t* rawData = (uint8_t* )data;
        if (kind() == CoverKind::Awning) {
            switch (dgn) {
                case AWNING_COMMAND:
                    // RV_PRINTF("CoverDevice::executeCommand AWNING_COMMANBD\n");
                    if (sAddress == SOURCE_ADDRESS) { // then we originated the command}
                        // RV_PRINTF("CoverDevice::executeCommand: Handling LOCK_COMMAND\n");
                        // need to send the command on the CAN BUS
                        frame = buildCommand(dgn);
                        if (frame != nullptr) {
                            // RV_PRINTF("CoverDevice::executeCommand: Sending command on CAN bus with MsgID=%#x\n", frame->MsgID);
                            PacketQueue::queuePacket(*frame); //Packet::queueItUpForSend(frame);
                        
                        }
                    } else {
                        updateViews(); // it came from the CAN bus, so we update the views
                    }
                    cmdExecuted = true;
                    break;
            
                case (AWNING_STATUS):
                    RV_PRINTF("CoverDevice::executeCommand case AWNING_STATUS\n");
                    // then we don't send a command on the CAN bus, we update our views (HOME SPAN)
                    // the -> the views will requst the data from the buffer
                    // if (!isCoverDeviceMoving()) {
                    setData(dgn, rawData);
                    updateViews();
                    cmdExecuted = true;
                    break;
                case (AWNING_COMMAND_2):
                    RV_PRINTF("CoverDevice::executeCommand - AWNING_COMMAND_2 called not supported yet\n");
                    break;
                case (AWNING_STATUS_2):
                    RV_PRINTF("CoverDevice::executeCommand - AWNING_STATUS_2 called not supported yet\n");
                    break;
                default:
                    break;
            }
        } else {
            switch (dgn) {
                case WINDOW_SHADE_CONTROL_COMMAND:
                    if (sAddress == SOURCE_ADDRESS) { // then we originated the command}
                        // RV_PRINTF("Shades::executeCommand: Handling LOCK_COMMAND\n");
                        // need to send the command on the CAN BUS
                        setData(dgn, rawData);
                        frame = buildCommand(dgn);
                        if (frame != nullptr) {
                            // RV_PRINTF("Shades::executeCommand: Sending command on CAN bus with MsgID=%#x\n", frame->MsgID);
                            PacketQueue::queuePacket(*frame); //Packet::queueItUpForSend(frame);
                        
                        }
                    } else {
                        updateViews(); // it came from the CAN bus, so we update the views
                    }
                    cmdExecuted = true;
                    break;
            
                case (WINDOW_SHADE_CONTROL_STATUS):
                    // RV_PRINTF("Shades::executeCommand case LOCK_STATUS\n");
                    // then we don't send a command on the CAN bus, we update our views (HOME SPAN)
                    // the -> the views will requst the data from the buffer
                    setData(dgn, rawData);
                    updateViews();
                    cmdExecuted = true;
                    break;
                default:
                    break;
            }
        }
    }
    return cmdExecuted; // Command execution failed
}
#endif // ifdef HOME_KIT_2
