#include "BatteryView.h"
#include "PowerSensorView.h"
#ifdef HOME_KIT_2

BatteryView::BatteryView(Battery* model, const char* name)
    : model_(model)
    , voltageChar_(nullptr)
    , currentChar_(nullptr)
    , rippleChar_(nullptr)
{
    // Re-use the shared voltage/current presentation
    // (or duplicate the small accessory block if you prefer no extra include)
    // Voltage tile
    new SpanAccessory();
        new Service::AccessoryInformation();
            new Characteristic::Name(name);
        new Service::TemperatureSensor();
            voltageChar_ = new Characteristic::CurrentTemperature(tempCfromTempF(VDC_NOMINAL_VALUE)); // 12v battery
            voltageChar_->setRange(tempCfromTempF(VDC_LOWER_LIMIT),tempCfromTempF(VDC_UPPER_LIMIT));
            new Characteristic::TemperatureDisplayUnits(homeKitTemperatureDisplayFahrenheit); // °F

    // Current tile
    new SpanAccessory();
        new Service::AccessoryInformation();
            new Characteristic::Name((String(name) + " Current").c_str());
        new Service::TemperatureSensor();
            currentChar_ = new Characteristic::CurrentTemperature(tempCfromTempF(ADC_NOMINAL_VALUE));
            currentChar_->setRange(tempCfromTempF(ADC_LOWER_LIMIT), tempCfromTempF(ADC_UPPER_LIMIT));
            new Characteristic::TemperatureDisplayUnits(homeKitTemperatureDisplayFahrenheit);

    // RMS Ripple tile (shown as temperature – same workaround)
    new SpanAccessory();
        new Service::AccessoryInformation();
            new Characteristic::Name((String(name) + " rmsRipple mv").c_str());
        new Service::TemperatureSensor();
            rippleChar_ = new Characteristic::CurrentTemperature(tempCfromTempF(VDC_RIPPLE_NOMINAL_VALUE));
            rippleChar_->setRange(tempCfromTempF(VDC_RIPPLE_LOWER_LIMIT), tempCfromTempF(VDC_RIPPLE_UPPER_LIMIT));          // 0–2500 mV is a sensible range
            new Characteristic::TemperatureDisplayUnits(homeKitTemperatureDisplayFahrenheit);
        // voltage + current characteristics identical to PowerSensorView
}


bool BatteryView::updateView()
{
   bool result = false;

    if (model_ != nullptr && isNeedToUpdateView()) {
        // Voltage (already scaled ×10 in the model)
        if (voltageChar_ != nullptr) {
            float v = model_->rmsVoltage(); // / 10.0f;
            voltageChar_->setVal(tempCfromTempF(v));
        }

        // Current
        if (currentChar_ != nullptr) {
            float a = model_->rmsCurrent(); //  / 10.0f;
            currentChar_->setVal(tempCfromTempF(a));
        }

        // RMS Ripple (raw value from the model – usually in mV or the scaled unit from RV-C)
        if (rippleChar_ != nullptr) {
            uint16_t ripple = model_->rmsRipplemv();
            if (ripple != OUT_OF_RANGE_DATA) {
                // Display the raw value (or divide by 10/100 if your scaling needs it)
                rippleChar_->setVal(tempCfromTempF(static_cast<float>(ripple)));
            }
        }

        dontUpdateTheView();
        result = true;
    }
    return result;
}


#endif
